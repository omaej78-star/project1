# Keep real values out of source control. Browser applications may only expose
# intentionally-public provider values (for example, a Supabase anon key).

# Server-only OAuth / JWT validation configuration
OAUTH_ISSUER_URL=https://your-auth-provider.example.com/
OAUTH_AUDIENCE=portfolio-api
OAUTH_JWKS_URI=https://your-auth-provider.example.com/.well-known/jwks.json

# Server-only data protection keys — do not prefix these as public/client values
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/portfolio
ENCRYPTION_KEY=replace-with-a-32-byte-secret-from-your-secret-manager
